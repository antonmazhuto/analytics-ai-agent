# Postgres from docker-compose.yml. If you changed DB_PORT, change the port here too.
# Owner role: migrations, seeding, indexing metric docs.
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics
# Read-only role (created by db/schema.sql): every query the agent runs at question time.
ANALYTICS_DATABASE_URL=postgres://analytics_ro:analytics_ro@localhost:5432/analytics

# Embeddings + chat are called through OpenRouter using the OpenAI SDK.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
